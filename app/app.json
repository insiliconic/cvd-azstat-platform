{
  "expo": {
    "name": "Cardiostatistics",
    "slug": "cardiostatistics",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cardiostatistics.app"
    },
    "android": {
      "package": "com.cardiostatistics.app",
      "adaptiveIcon": {
        "backgroundColor": "#2a78d6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0d0d0d"
          }
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "240d78ef-80db-4f3b-8319-cd64b587ba29"
      }
    },
    "owner": "insiliconic",
    "updates": {
      "url": "https://u.expo.dev/240d78ef-80db-4f3b-8319-cd64b587ba29"
    }
  }
}
